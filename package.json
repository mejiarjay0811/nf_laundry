{
  "name": "nf-laundry-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "N & F Laundry POS - Point of Sale and Management System",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:appsscript": "node scripts/build-appsscript.mjs",
    "start": "node dist/server/server/index.js",
    "setup": "tsx server/scripts/setup.ts",
    "admin:password": "tsx server/scripts/admin-password.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rpc": "tsx scripts/smoke-rpc.mjs",
    "test:appsscript": "node scripts/build-appsscript.mjs && node scripts/test-appsscript-bundle.mjs",
    "verify": "npm run typecheck && npm run test && npm run test:rpc && npm run test:appsscript",
    "lint:types": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "check": "tsx server/scripts/check-connection.ts",
    "reset:data": "tsx server/scripts/reset-data.ts",
    "android:build": "npm run build:client && npx cap sync android && node scripts/build-android.mjs",
    "android:open": "npx cap open android",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-app-icons.ps1 && npx @capacitor/assets generate --android",
    "desktop:install": "npm install --prefix desktop",
    "desktop:start": "npm run build:client && npm --prefix desktop run start",
    "desktop:build": "npm run build:client && npm --prefix desktop run dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tanstack/react-query": "^5.59.16",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.456.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
