# ---------------------------------------------------------------------------
# N & F LAUNDRY POS — server configuration
# Copy this file to ".env" and fill in the values. Never commit ".env".
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# API_PORT wins over PORT when set. Use it in development so the API does not
# collide with the Vite dev server; leave it unset in production so the host-
# injected PORT is used.
API_PORT=4000
LOG_LEVEL=info

# --- Session -----------------------------------------------------------------
# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
SESSION_TTL_MINUTES=480
SESSION_REMEMBER_DAYS=14
COOKIE_SECURE=false
COOKIE_NAME=nf_session

# --- Data source -------------------------------------------------------------
# One of: apps-script | google-api | local
#
#   apps-script  RECOMMENDED for production. Uses the Web App in apps-script/
#                Code.gs, whose LockService makes counter increments and row
#                updates genuinely atomic.
#   google-api   Sheets REST API with a service account. No cross-process lock,
#                so run exactly one server instance.
#   local        File-backed emulator for development and tests. Same contract,
#                no Google account needed.
SHEETS_PROVIDER=local

GOOGLE_SPREADSHEET_ID=1KjSDxY4WirVlzf-ZSv_v212EYqlo6eM71YR0xUj2PWE

# --- apps-script driver ------------------------------------------------------
# The /exec URL of the deployed Web App, and the shared token you set as the
# API_TOKEN script property.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
APPS_SCRIPT_TIMEOUT_MS=20000

# Where the BROWSER sends its requests during "npm run dev". Leave blank and the
# dev client talks to the Node server on API_PORT.
#
# Set it to the same /exec URL above when SHEETS_PROVIDER=apps-script, or
# sign-in will fail for every account no matter what the password is: passwords
# on the live sheet are hashed inside the deployment with a pepper that never
# leaves it, so the Node server has nothing it can check them against. Released
# builds get this from .env.production and are unaffected either way.
VITE_API_URL=

# --- google-api driver -------------------------------------------------------
# Either provide the service-account email plus private key inline (escape the
# newlines as \n), or point GOOGLE_APPLICATION_CREDENTIALS at a key file.
# Remember to share the spreadsheet with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- local driver ------------------------------------------------------------
LOCAL_DATA_DIR=.data

# --- Performance -------------------------------------------------------------
CACHE_TTL_SECONDS=30
SHEETS_MAX_RETRIES=3

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Leave blank when the API and
# the client are served from the same origin.
CORS_ORIGIN=
TRUST_PROXY=false
SERVE_CLIENT=true

# --- First-run setup only ----------------------------------------------------
# Used by "npm run setup" when the Users sheet is empty. If the password is
# left blank a strong one is generated and printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=System Administrator
