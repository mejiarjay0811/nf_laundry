# Loaded by `vite build` only, so local development still talks to the Node
# server through the dev proxy while released builds go straight to the backend.
#
# This URL is not a secret. It is a public endpoint that returns nothing until
# someone signs in, which is why it is safe to bake into the APK.
#
# It stays the same as long as the script is re-deployed with
# "Manage deployments -> edit -> New version". Creating a *new* deployment
# mints a different URL and would strand every installed copy of the app.
VITE_API_URL=https://script.google.com/macros/s/AKfycbxDIf8CY7qkKjPRn7gXNLwhsSx-VW1B6_eL9x9YPzEMYdxQaoP4e2nXiYnqjpQnM4lX/exec